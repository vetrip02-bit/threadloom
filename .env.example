# ---------------------------------------------------------------------------
# PUBLIC — safe to expose in the browser bundle
# ---------------------------------------------------------------------------
# Canonical site origin, used for metadata, Open Graph, sitemap and canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing. Leave unset (or anything other than "true") while the
# site still carries placeholder contact details, template legal pages and
# sample pricing - the whole site then serves noindex. Set to exactly "true"
# only once that content is real.
NEXT_PUBLIC_ALLOW_INDEXING=

# Supabase project URL and anon/publishable key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix any of the values below with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Zoho CRM self-client / server-based OAuth application
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Accounts host for YOUR data centre, e.g.
#   India        https://accounts.zoho.in
#   US           https://accounts.zoho.com
#   Europe       https://accounts.zoho.eu
#   Australia    https://accounts.zoho.com.au
#   Japan        https://accounts.zoho.jp
#   Canada       https://accounts.zohocloud.ca
#   Saudi Arabia https://accounts.zoho.sa
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Fallback API domain. The server prefers the `api_domain` Zoho returns with the
# access token, so this is only used when that field is absent.
ZOHO_API_DOMAIN=https://www.zohoapis.in

# CRM module that receives registered customers (normally Contacts).
ZOHO_CRM_MODULE=Contacts

# CRM module that receives quote enquiries. Leads works out of the box; point
# this at a custom module API name once you create one.
ZOHO_QUOTE_MODULE=Leads

# Optional: set to "1" to log full (redacted) Zoho responses on the server
# while you are wiring the integration up. Leave unset in production.
ZOHO_DEBUG=
