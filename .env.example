# ===========================================================================
# REQUIRED - without these two, the quote form cannot deliver an enquiry and
# the API deliberately returns an error rather than faking success.
# ===========================================================================

# Resend API key. Get one free at https://resend.com -> API Keys ("re_...").
RESEND_API_KEY=

# Where enquiries are delivered. Your real sales inbox.
ENQUIRY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Sender address.
#
# Leave unset to use Resend's shared sandbox sender (onboarding@resend.dev).
# IMPORTANT: the sandbox sender only delivers to the email address that owns
# the Resend account. To send to any other address, verify your own domain in
# Resend and set something like enquiries@yourdomain.com here.
# ---------------------------------------------------------------------------
ENQUIRY_FROM_EMAIL=

# ===========================================================================
# PUBLIC - these are exposed in the browser bundle (safe: they are the same
# details already printed in the site footer).
# ===========================================================================

# Canonical origin. Set this to your real domain in production - the sitemap,
# canonical tags and Open Graph URLs are derived from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing. The whole site serves noindex unless this is exactly
# "true". Turn it on only once the placeholder content below is replaced.
NEXT_PUBLIC_ALLOW_INDEXING=

# Contact details shown in the header, footer, contact page, and in the
# "email or call us directly" fallback when an enquiry cannot be delivered.
# Until these are set the site shows obvious [bracketed] placeholders.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Address lines, separated by a pipe character:
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_GSTIN=

# ===========================================================================
# OPTIONAL - Zoho CRM. Leave blank and the site works fine; enquiries still
# arrive by email. Configure it to ALSO file each enquiry as a CRM record.
# Never prefix any of these with NEXT_PUBLIC_.
# ===========================================================================
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Accounts host for YOUR data centre, e.g.
#   India  https://accounts.zoho.in      US  https://accounts.zoho.com
#   Europe https://accounts.zoho.eu      AU  https://accounts.zoho.com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Fallback API domain; the server prefers the api_domain Zoho returns.
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Module that receives quote enquiries.
ZOHO_QUOTE_MODULE=Leads

# Set to "1" to log redacted Zoho response codes while wiring up.
ZOHO_DEBUG=
